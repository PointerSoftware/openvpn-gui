# OpenVPN Channel Bonding Configuration
# Profile: Weighted Distribution Example
# 
# This example demonstrates weighted distribution mode with 3 tunnels.
# Traffic is distributed proportionally based on weight values.

# Bonding Mode
# Options: round-robin, weighted, active-backup
bonding-mode weighted

# Number of tunnels (must match number of [tunnel-N] sections below)
tunnel-count 3

# Tunnel 0 Configuration (Highest weight - receives most traffic)
[tunnel-0]
# Physical NIC name (must match a detected NIC)
nic-name "Ethernet"

# OpenVPN server endpoint
server-host vpn.example.com
server-port 1194

# Base OpenVPN configuration file
server-config base.ovpn

# Distribution weight (higher = more traffic)
weight 3

# Tunnel 1 Configuration (Medium weight)
[tunnel-1]
nic-name "Wi-Fi"
server-host vpn.example.com
server-port 1195
server-config base.ovpn
weight 2

# Tunnel 2 Configuration (Lowest weight - receives least traffic)
[tunnel-2]
nic-name "LTE"
server-host vpn.example.com
server-port 1196
server-config base.ovpn
weight 1

# Standard OpenVPN parameters (applied to all tunnels)
# These can also be in the base.ovpn file referenced above
remote vpn.example.com
proto udp
dev tun
ca ca.crt
cert client.crt
key client.key
cipher AES-256-GCM
auth SHA256
tls-version-min 1.2
